[Unit]
Description=LIMS NGS Panel Service: Variant SNV Plugin

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=java -jar /data/lims/panel-service-variant-snv.jar --spring.config.location=/etc/lims/panel-service-variant-snv.yml
ExecReload=/bin/kill -INT 
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
