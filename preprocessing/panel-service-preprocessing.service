[Unit]
Description=LIMS NGS Panel Service: Preprocessing Plugin

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=java -jar /data/lims/panel-service-preprocessing.jar --spring.config.location=/etc/lims/panel-service-preprocessing.yml
ExecReload=/bin/kill -INT 
KillMode=control-group
Restart=on-failure
RestartSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
