[Unit]
Description=LIMS NGS Panel Service: Trello Plugin

[Service]
WorkingDirectory=/usr/local/bin
ExecStart=/usr/lib/jvm/jre-17/bin/java -jar /data/lims/panel-service-trello.jar --spring.config.location=/etc/lims/panel-service-trello.yml
ExecReload=/bin/kill -INT 
KillMode=control-group
Restart=on-failure
TimeoutStopSec=10s
Type=simple
User=root
Group=greencross

[Install]
WantedBy=multi-user.target
